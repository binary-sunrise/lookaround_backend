# ==============================================================================
# B-Liffe Backend - Environment Configuration Template
# ==============================================================================

# Application & Environment
NODE_ENV=development
APP_NAME="B-Liffe Biodiversity Field Data API"
SERVICE_NAME="b-liffe-backend"
APP_VERSION="2.0.0"

# Server Configuration
PORT=3000
HOST=0.0.0.0
BODY_LIMIT=50mb

# CORS & Client URLs
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL=false

# ==============================================================================
# Database Configuration - AWS RDS PostgreSQL (ap-southeast-2 Sydney or ap-south-1 Mumbai)
# ==============================================================================
# Replace placeholders with your AWS RDS instance details:
# Example Endpoint: bliffe-db.cxags06gwym1.ap-southeast-2.rds.amazonaws.com
DB_HOST=your-rds-endpoint.ap-southeast-2.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_rds_password
DB_NAME=bliffe_db

# Prisma Primary Connection URL (AWS RDS PostgreSQL with SSL)
DATABASE_URL="postgresql://postgres:your_secure_rds_password@your-rds-endpoint.ap-southeast-2.rds.amazonaws.com:5432/bliffe_db?sslmode=no-verify"

# Direct URL for Prisma CLI & Migrations
DIRECT_URL="postgresql://postgres:your_secure_rds_password@your-rds-endpoint.ap-southeast-2.rds.amazonaws.com:5432/bliffe_db?sslmode=no-verify"

# Database SSL & Security Settings
# AWS RDS requires SSL. To verify the Amazon RDS CA certificate, set REJECT_UNAUTHORIZED=true
# and supply the path to the downloaded RDS global CA bundle.
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
RDS_CA_BUNDLE_PATH=certs/global-bundle.pem

# Connection Pool Tuning for RDS Free Tier (db.t3.micro / db.t4g.micro with 1GB RAM)
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000
DB_KEEP_ALIVE_INITIAL_DELAY_MS=10000

# ==============================================================================
# Alternative: Local PostgreSQL (Docker Compose)
# ==============================================================================
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=lookaround_db
# DB_HOST=localhost
# DB_PORT=5433
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=lookaround_db
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/lookaround_db?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5433/lookaround_db?schema=public"
# DATABASE_SSL=false

# ==============================================================================
# Authentication (Better Auth & Session Management)
# ==============================================================================
BETTER_AUTH_SECRET=generate_a_random_32_character_secret_key_here!
BETTER_AUTH_URL=http://localhost:3000
AUTH_SESSION_EXPIRES_IN_SECONDS=604800
AUTH_SESSION_UPDATE_AGE_SECONDS=86400
AUTH_COOKIE_CACHE_MAX_AGE_SECONDS=300
AUTH_MIN_PASSWORD_LENGTH=6

# Optional OAuth Providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
