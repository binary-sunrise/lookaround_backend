# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL)
# Using 5433 to prevent collision with local Windows PostgreSQL service on 5432
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lookaround_db

# Docker Compose Environment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lookaround_db

# Prisma Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/lookaround_db?schema=public"
