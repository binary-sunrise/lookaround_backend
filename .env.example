# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL)
# Using 5433 to prevent collision with local Windows PostgreSQL service on 5432
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lookaround_db

# Docker Compose Environment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lookaround_db

# Prisma Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/lookaround_db?schema=public"

# Authentication (Better Auth)
BETTER_AUTH_SECRET=lookaround_auth_secret_development_min_32_chars_ok!
BETTER_AUTH_URL=http://localhost:3000

# Optional OAuth Providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
