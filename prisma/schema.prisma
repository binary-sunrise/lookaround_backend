datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Hub {
  id          String   @id
  url         String
  name        String
  description String
  logo        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hubs")
}

model Project {
  projectId               String        @id
  name                    String
  description             String?       @default("")
  startDate               String?
  endDate                 String?
  plannedStartDate        String?
  plannedEndDate          String?
  urlImage                String?
  fullSizeImageUrl        String?
  urlWeb                  String?
  projectLogoImage        String?
  projectLogoImageCredit  String?
  contactName             String?
  contactDetails          String?
  projectTask             String?
  projectEquipment        String?
  projectHowToParticipate String?
  organisationName        String?       @default("")
  organisationId          String?
  aim                     String?
  difficulty              String?
  isExternal              Boolean       @default(false)
  isSciStarter            Boolean       @default(false)
  isMERIT                 Boolean       @default(false)
  projectType             String?
  hub                     String?
  keywords                String[]      @default([])
  tags                    String[]      @default([])
  scienceType             String[]      @default([])
  ecoScienceType          String[]      @default([])
  rawData                 Json?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  surveys                 Survey[]
  activities              BioActivity[]

  @@map("projects")
}

model Survey {
  id                String   @id
  projectActivityId String?
  name              String
  description       String?  @default("")
  startDate         String?
  endDate           String?
  status            String?  @default("Active")
  published         Boolean  @default(true)
  publicAccess      Boolean  @default(true)
  projectId         String?
  rawData           Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project           Project? @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@index([projectId])
  @@map("surveys")
}

model BioActivity {
  activityId        String   @id
  projectActivityId String
  type              String
  status            String
  lastUpdated       String
  endDate           String?
  userId            String
  name              String
  projectName       String?  @default("")
  projectId         String?
  activityOwnerName String?
  siteId            String?
  embargoed         Boolean  @default(false)
  embargoUntil      String?  @default("")
  projectType       String?
  thumbnailUrl      String?
  showCrud          Boolean  @default(true)
  userCanModerate   Boolean  @default(true)
  records           Json?    @default("[]")
  rawData           Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project           Project? @relation(fields: [projectId], references: [projectId], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([projectActivityId])
  @@map("bio_activities")
}

model User {
  id            String    @id
  sub           String?   @unique
  name          String
  givenName     String?
  familyName    String?
  email         String    @unique
  emailVerified Boolean   @default(true)
  image         String?
  role          String?
  roles         String[]  @default([])
  customUserId  String?
  avatar        String?
  organisation  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  profile       UserProfile?

  @@map("users")
}

model UserProfile {
  id              String   @id @default(uuid())
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  displayName     String
  email           String   @unique
  bio             String   @default("")
  avatarType      String   @default("preset")
  avatarPresetId  String   @default("user")
  avatarCustomUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("user_profiles")
}

model BLiffeProject {
  id           String              @id @default(uuid())
  name         String
  description  String?             @default("")
  startDate    String?
  status       String              @default("active")
  organization String?             @default("")
  targetRegion String?             @default("")
  syncStatus   String              @default("synced")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  wards        BLiffeWard[]
  surveys      BLiffeSurvey[]
  observations BLiffeObservation[]

  @@map("bliffe_projects")
}

model BLiffeWard {
  id            String              @id @default(uuid())
  projectId     String
  wardNumber    String
  wardName      String
  localBodyName String?             @default("")
  district      String?             @default("")
  state         String?             @default("")
  keyLandmarks  String?             @default("")
  syncStatus    String              @default("synced")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  project       BLiffeProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  surveys       BLiffeSurvey[]
  observations  BLiffeObservation[]

  @@index([projectId])
  @@map("bliffe_wards")
}

model BLiffeSurvey {
  id           String              @id @default(uuid())
  projectId    String
  wardId       String
  leadObserver String
  teamMembers  String[]            @default([])
  surveyMethod String?             @default("Opportunistic Encounter")
  habitatType  String?             @default("Urban Park / Garden")
  targetGroup  String?             @default("All Biodiversity")
  startTime    String
  endTime      String?
  weatherNotes String?             @default("")
  syncStatus   String              @default("synced")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  project      BLiffeProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ward         BLiffeWard          @relation(fields: [wardId], references: [id], onDelete: Cascade)
  observations BLiffeObservation[]

  @@index([projectId])
  @@index([wardId])
  @@map("bliffe_surveys")
}

model BLiffeObservation {
  id                              String         @id @default(uuid())
  surveyId                        String?
  wardId                          String?
  wardName                        String?
  projectId                       String?
  projectIds                      String[]       @default([])
  speciesName                     String
  scientificName                  String?        @default("")
  localName                       String?        @default("")
  speciesGroup                    String?        @default("")
  speciesGroups                   String?        @default("")
  otherSpeciesGroup               String?        @default("")
  identificationStatus            String?        @default("Identified")
  organismStatus                  String?        @default("Wild")
  locationVisibility              String?        @default("Open")
  basis_of_record                 String         @default("HumanObservation")
  tags                            String[]       @default([])
  notes                           String         @default("")
  individualCount                 Int            @default(1)
  lifeStage                       String?        @default("")
  microHabitat                    String?        @default("")
  otherMicroHabitat               String?        @default("")
  hasTraditionalKnowledge         String?        @default("No")
  traditionalKnowledgeSource      String?        @default("")
  otherTraditionalKnowledgeSource String?        @default("")
  gps_latitude                    Float?
  gps_longitude                   Float?
  latitude                        Float?
  longitude                       Float?
  location_source                 String?        @default("GPS")
  accuracyMeters                  Float?
  observationAt                   String
  recordedAt                      String
  photos                          String[]       @default([])
  verificationStatus              String?        @default("Unreviewed")
  verifiedBy                      String?        @default("")
  verificationNotes               String?        @default("")
  syncStatus                      String         @default("synced")
  userId                          String?
  createdAt                       DateTime       @default(now())
  updatedAt                       DateTime       @updatedAt

  project                         BLiffeProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  ward                            BLiffeWard?    @relation(fields: [wardId], references: [id], onDelete: SetNull)
  survey                          BLiffeSurvey?  @relation(fields: [surveyId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([wardId])
  @@index([surveyId])
  @@index([userId])
  @@map("bliffe_observations")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verifications")
}

