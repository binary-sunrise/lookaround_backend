# ==============================================================================
# LookAround Backend - Production Environment Configuration
# ==============================================================================
# Use these environment variables when configuring your remote hosting platform
# (e.g. Render Web Service Dashboard, Fly.io secrets, or Koyeb Environment settings).
# IMPORTANT: Never commit actual production passwords or OAuth secrets to git.

# ------------------------------------------------------------------------------
# 1. Server & Host Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
# In production, cloud platforms (Render, Fly.io, Koyeb) assign PORT dynamically
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Primary public URL of your deployed frontend (e.g. Vercel, Netlify, Cloudflare Pages)
FRONTEND_URL=https://lookaround-pwa.vercel.app

# Additional comma-separated origins allowed to make authenticated API calls
# (Includes testing clients like Hoppscotch Web, Swagger UI, or local mirrors)
ALLOWED_ORIGINS=https://lookaround-pwa.vercel.app,https://hoppscotch.io,http://localhost:5173

# Set to true only if you want to reflect any incoming origin for open demo testing
CORS_ALLOW_ALL=false

# ------------------------------------------------------------------------------
# 3. Remote Cloud PostgreSQL (Neon Serverless)
# ------------------------------------------------------------------------------
# High-concurrency pooled connection URL used by the backend application at runtime
# (Notice: Use ?sslmode=require and omit channel_binding=require for Node.js pg compatibility)
DATABASE_URL="postgresql://neondb_owner:YOUR_DATABASE_PASSWORD@ep-dry-lab-b3z2e116-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection URL used specifically by Prisma migrations (DDL advisory locks)
DIRECT_URL="postgresql://neondb_owner:YOUR_DATABASE_PASSWORD@ep-dry-lab-b3z2e116.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Enforce TLS encryption for remote database queries
DATABASE_SSL=true

# Keep false for serverless/pooled providers that use cloud proxy certificates without local root CAs
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ------------------------------------------------------------------------------
# 4. Authentication (Better Auth)
# ------------------------------------------------------------------------------
# Secret key used to encrypt and sign session tokens and cookies (minimum 32 characters)
BETTER_AUTH_SECRET=your_secure_random_32_character_string_here_min_32_chars!

# The public canonical URL of your deployed backend service (no trailing slash)
# Replace with your actual Render service URL once created (e.g. https://<service-name>.onrender.com)
BETTER_AUTH_URL=https://lookaround-backend.onrender.com

# ------------------------------------------------------------------------------
# 5. Third-Party OAuth Providers
# ------------------------------------------------------------------------------
# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth Credentials (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
