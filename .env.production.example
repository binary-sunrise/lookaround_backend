# ==============================================================================
# LookAround Backend - Production Environment Template
# ==============================================================================
# Use this template when deploying to free remote hosting (Render, Fly.io, Koyeb, etc.)
# IMPORTANT: Never commit actual production secrets to version control.

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
# In production, platforms (Render, Fly.io, Koyeb) automatically set PORT via environment variable.
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Primary URL of your deployed frontend (e.g. Vercel, Netlify, Cloudflare Pages)
FRONTEND_URL=https://lookaround-pwa.vercel.app

# Additional comma-separated origins allowed to make authenticated cross-origin requests
# (Include testing clients like Hoppscotch Web, staging URLs, or local dev mirrors)
ALLOWED_ORIGINS=https://lookaround-pwa.vercel.app,https://hoppscotch.io,http://localhost:5173

# Set to true only if you want to reflect any incoming origin for open demo testing
CORS_ALLOW_ALL=false

# ------------------------------------------------------------------------------
# 3. Remote Managed Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Supported Free Providers:
# - Neon (Serverless Postgres): postgresql://<user>:<password>@<ep-pooler>.us-east-2.aws.neon.tech/<dbname>?sslmode=require
# - Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# - Render PostgreSQL: postgresql://<user>:<password>@dpg-<id>-a.<region>-postgres.render.com/<dbname>
DATABASE_URL="postgresql://neondb_owner:YOUR_STRONG_PASSWORD@ep-delicate-flower-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Enforce SSL encryption for cloud database connections
DATABASE_SSL=true

# Keep false for serverless/pooled providers that use cloud proxy certificates without local root CAs
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ------------------------------------------------------------------------------
# 4. Authentication (Better Auth)
# ------------------------------------------------------------------------------
# Generate a secure 32+ character random key:
# Run: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace_with_a_secure_random_32_character_string_here_now!

# The public canonical URL of this deployed backend service (no trailing slash)
# Example for Render: https://lookaround-backend.onrender.com
# Example for Koyeb:  https://lookaround-backend.koyeb.app
BETTER_AUTH_URL=https://lookaround-backend.onrender.com

# ------------------------------------------------------------------------------
# 5. Optional Third-Party OAuth Providers
# ------------------------------------------------------------------------------
# Set only if enabling social login in production
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres — your database connection
DATABASE_URL="postgresql://neondb_owner:npg_k6hLXeCVtE2F@ep-dry-lab-b3z2e116.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_POOLED="postgresql://neondb_owner:npg_k6hLXeCVtE2F@ep-dry-lab-b3z2e116-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
