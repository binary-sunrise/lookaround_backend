              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"wardId\": \"{{wardId}}\",\n  \"wardName\": \"Ward 14 – Palayam\",\n  \"surveyId\": \"{{surveyId}}\",\n  \"speciesName\": \"Southern Birdwing\",\n  \"scientificName\": \"Troides minos\",\n  \"localName\": \"ഗരുഡശലഭം\",\n  \"speciesGroup\": \"Insects / Butterflies\",\n  \"identificationStatus\": \"Identified\",\n  \"organismStatus\": \"Wild\",\n  \"locationVisibility\": \"Open\",\n  \"basis_of_record\": \"HumanObservation\",\n  \"tags\": [\"state-butterfly\", \"pollinator\", \"canopy-dwelling\"],\n  \"notes\": \"State butterfly of Kerala observed nectaring on Pagoda flower in the afternoon.\",\n  \"individualCount\": 2,\n  \"lifeStage\": \"Adult\",\n  \"microHabitat\": \"Tree Canopy\",\n  \"hasTraditionalKnowledge\": \"Yes\",\n  \"traditionalKnowledgeSource\": \"Elder / knowledgeable local resident\",\n  \"latitude\": 8.4982,\n  \"longitude\": 76.9534,\n  \"accuracyMeters\": 4.5,\n  \"location_source\": \"GPS\",\n  \"observationAt\": \"2026-10-30T08:15:00.000Z\",\n  \"recordedAt\": \"2026-10-30T08:15:00.000Z\",\n  \"photos\": [\"https://images.unsplash.com/photo-1544979590-37e9b47eb705\"]\n}"
